{
  "manifest_version": 3,
  "name": "OpenDM Integration",
  "description": "Send browser downloads, links and web-player media to the OpenDM download manager.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_title": "OpenDM (click to toggle integration)"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_start" }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/icon16.png", "icons/icon32.png"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "options_page": "options.html",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "tabs", "scripting", "webRequest", "webNavigation", "alarms"],
  "host_permissions": ["<all_urls>"]
}
