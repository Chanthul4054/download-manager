{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDM",
  "version": "2.0.0",
  "identifier": "com.opendm.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "OpenDM contributors",
    "copyright": "OpenDM contributors",
    "shortDescription": "OpenDM",
    "longDescription": "A multi-connection download manager with browser integration, queues, scheduler, site grabber and video capture.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../extension/": "extension/"
    }
  }
}
