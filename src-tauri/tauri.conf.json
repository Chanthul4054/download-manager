{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDM",
  "version": "2.0.0",
  "identifier": "com.opendm.app",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "OpenDM contributors",
    "copyright": "OpenDM contributors",
    "shortDescription": "OpenDM",
    "longDescription": "A multi-connection download manager with browser integration, queues, scheduler, site grabber and video capture.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../extension/": "extension/"
    }
  }
}
