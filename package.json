{
  "name": "opendm",
  "productName": "OpenDM",
  "version": "1.0.0",
  "description": "A multi-connection download manager with browser integration, queues, scheduler, site grabber and video capture.",
  "main": "src/main/main.js",
  "author": "OpenDM contributors",
  "license": "MIT",
  "repository": "https://github.com/Chanthul4054/download-manager",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "basic-ftp": "6.2.3",
    "socks": "2.8.10"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "build": {
    "appId": "com.opendm.app",
    "productName": "OpenDM",
    "copyright": "OpenDM contributors",
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "OpenDM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenDM",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
