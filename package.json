{
  "name": "opendm",
  "productName": "OpenDM",
  "version": "1.1.0",
  "description": "A multi-connection download manager with browser integration, queues, scheduler, site grabber and video capture.",
  "author": "OpenDM contributors",
  "license": "MIT",
  "repository": "https://github.com/Chanthul4054/download-manager",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dist": "tauri build && node -e \"const fs=require('fs'),v=require('./package.json').version,d='src-tauri/target/release/bundle/nsis/';fs.mkdirSync('dist',{recursive:true});fs.copyFileSync(d+fs.readdirSync(d).find(f=>f.endsWith('-setup.exe')),'dist/OpenDM-Setup-'+v+'.exe');console.log('dist/OpenDM-Setup-'+v+'.exe')\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
